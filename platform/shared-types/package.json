{
  "name": "@acc-reliability/shared-types",
  "version": "0.1.0",
  "description": "ACC Reliability Platform — Shared Primitive Types",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "node ../../node_modules/typescript/bin/tsc --project tsconfig.json",
    "build:watch": "node ../../node_modules/typescript/bin/tsc --project tsconfig.json --watch",
    "clean": "rimraf dist",
    "type-check": "node ../../node_modules/typescript/bin/tsc --noEmit",
    "lint": "node -e \"console.log('[shared-types] lint: eslint not yet configured')\"",
    "test": "node -e \"console.log('[shared-types] test: no framework configured')\""
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "rimraf": "^5.0.5",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
