{
  "name": "acc-reliability-platform",
  "version": "1.0.0",
  "private": true,
  "description": "ACC Reliability Platform Implementation Workspace",
  "license": "Proprietary",
  "workspaces": [
    "apps/*",
    "modules/*",
    "platform/*",
    "backend"
  ],
  "scripts": {
    "dev":            "turbo run dev",
    "build":          "turbo run build",
    "test":           "turbo run test",
    "lint":           "turbo run lint",
    "type-check":          "node node_modules/typescript/bin/tsc --build platform/shared-types/tsconfig.json platform/cache/tsconfig.json platform/kernel/tsconfig.json platform/services/tsconfig.json platform/storage/tsconfig.json platform/sdk/tsconfig.json platform/gateway/tsconfig.json backend/tsconfig.json modules/oil-lubrication/tsconfig.json",
    "shared-types:build":  "npm run build --workspace=platform/shared-types",
    "shared-types:check":  "node node_modules/typescript/bin/tsc --project platform/shared-types/tsconfig.json --noEmit",
    "shared-types:clean":  "npm run clean --workspace=platform/shared-types",
    "cache:build":         "npm run build --workspace=platform/cache",
    "cache:check":         "node node_modules/typescript/bin/tsc --project platform/cache/tsconfig.json --noEmit",
    "cache:clean":         "npm run clean --workspace=platform/cache",
    "kernel:build":        "npm run build --workspace=platform/kernel",
    "kernel:check":        "node node_modules/typescript/bin/tsc --project platform/kernel/tsconfig.json --noEmit",
    "kernel:clean":        "npm run clean --workspace=platform/kernel",
    "services:build":      "npm run build --workspace=platform/services",
    "services:check":      "node node_modules/typescript/bin/tsc --project platform/services/tsconfig.json --noEmit",
    "services:clean":      "npm run clean --workspace=platform/services",
    "storage:build":       "npm run build --workspace=platform/storage",
    "storage:check":       "node node_modules/typescript/bin/tsc --project platform/storage/tsconfig.json --noEmit",
    "storage:clean":       "npm run clean --workspace=platform/storage",
    "sdk:build":           "npm run build --workspace=platform/sdk",
    "sdk:check":           "node node_modules/typescript/bin/tsc --project platform/sdk/tsconfig.json --noEmit",
    "sdk:clean":           "npm run clean --workspace=platform/sdk",
    "gateway:build":       "npm run build --workspace=platform/gateway",
    "gateway:check":       "node node_modules/typescript/bin/tsc --project platform/gateway/tsconfig.json --noEmit",
    "gateway:clean":       "npm run clean --workspace=platform/gateway",
    "backend:build":       "npm run build --workspace=backend",
    "backend:check":       "node node_modules/typescript/bin/tsc --project backend/tsconfig.json --noEmit",
    "backend:clean":       "npm run clean --workspace=backend",
    "app:build":           "npm run build --workspace=apps/owner-center",
    "app:check":           "node node_modules/typescript/bin/tsc --project apps/owner-center/tsconfig.json --noEmit",
    "app:clean":           "npm run clean --workspace=apps/owner-center",
    "oil-lubrication:build": "npm run build --workspace=modules/oil-lubrication",
    "oil-lubrication:check": "node node_modules/typescript/bin/tsc --project modules/oil-lubrication/tsconfig.json --noEmit",
    "oil-lubrication:clean": "npm run clean --workspace=modules/oil-lubrication"
  },
  "packageManager": "npm@11.16.0",
  "devDependencies": {
    "turbo": "^2.10.0"
  }
}
