{
  "name": "@acc-reliability/backend",
  "version": "0.1.0",
  "description": "ACC Reliability Platform — Backend runtime contracts (GAS adapter layer)",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "node ../node_modules/typescript/bin/tsc --project tsconfig.json",
    "build:watch": "node ../node_modules/typescript/bin/tsc --project tsconfig.json --watch",
    "clean": "rimraf dist",
    "type-check": "node ../node_modules/typescript/bin/tsc --noEmit",
    "lint": "node -e \"console.log('[backend] lint: eslint not yet configured')\"",
    "test": "node -e \"console.log('[backend] test: no framework configured')\""
  },
  "dependencies": {
    "@acc-reliability/shared-types": "*",
    "@acc-reliability/services": "*",
    "@acc-reliability/gateway": "*",
    "@acc-reliability/kernel": "*"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "rimraf": "^5.0.5",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
